TAVILY_API_KEY=your_tavily_key_here
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile
TAVILY_MAX_RESULTS=5
MAX_CHAT_HISTORY=6
LOG_LEVEL=INFO

# Redis Cache
REDIS_URL=redis://localhost:6379

# LangSmith Tracing
LANGCHAIN_API_KEY=your_langsmith_key_here
